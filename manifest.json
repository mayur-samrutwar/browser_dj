{
  "manifest_version": 3,
  "name": "Browser DJ",
  "version": "0.2.4",
  "description": "Two independent YouTube decks and one practice mixer in a single browser tab.",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Browser DJ",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/robots.txt*"
      ],
      "css": [
        "mixer.css",
        "beatmatch.css"
      ],
      "js": [
        "mix.js",
        "deck.js",
        "splitter.js",
        "beatmath.js",
        "beatmatch.js",
        "mixer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
